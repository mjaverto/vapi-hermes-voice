# vapi-hermes-voice configuration
# Copy to .env and fill in the three required values. Everything else is optional;
# commented lines show the default.

# --- required ---------------------------------------------------------------

# Hermes API server base URL (API_SERVER_ENABLED=true in ~/.hermes/.env)
VHV_HERMES_BASE_URL=http://127.0.0.1:8642

# Bearer token: must match API_SERVER_KEY in the Hermes profile's .env
VHV_HERMES_API_KEY=replace-with-your-hermes-api-server-key

# Static API key Vapi presents in the Authorization header, minimum 16 chars
# (use 32+). Paste the same value into the Vapi custom-llm credential.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
VHV_ADAPTER_API_KEY=generate-with-python-secrets-token-urlsafe-32

# --- optional defense-in-depth ------------------------------------------------

# When set (min 16 chars), the endpoint moves to /v/<secret>/chat/completions and
# the bare /chat/completions path 404s. Configure the Vapi model URL as
# https://your-host/v/<secret> in that case.
#VHV_ROUTE_SECRET=

# --- listener ----------------------------------------------------------------

# Bind address/port. Keep loopback; terminate TLS at a reverse proxy.
#VHV_LISTEN_HOST=127.0.0.1
#VHV_LISTEN_PORT=8766

# --- caller policy -----------------------------------------------------------

# Comma-separated E.164 allowlist for INBOUND calls. Empty = allowlist DISABLED
# (allow all, warn). When set, inbound calls without caller identity (web calls,
# metadataSendMode=off) are DENIED -- the allowlist fails closed. Outbound task
# calls are never screened against it: there customer.number is the callee, not a
# caller, so screening it would deny every call the operator placed.
#VHV_ALLOWED_CALLERS=+15550000001,+15550000002

# --- voice behavior ----------------------------------------------------------
# The greeting itself is configured on the Vapi assistant (firstMessage), not here.

# Identity used in the voice instructions.
#VHV_ASSISTANT_NAME=the assistant
#VHV_PRINCIPAL=the operator

# Comma-separated acknowledgement lines spoken during dead air (must be non-empty).
# Keep them short and free of any claim to be looking something up: they are spoken
# on turns where no tool runs at all. Default: 8 built-in phrases.
#VHV_FILLER_PHRASES=Okay, let me check.,Okay, one moment.

# The acknowledgement budget, decomposed. The callee must hear something within 2 s of
# finishing their sentence, measured on THEIR clock, and most of that is not ours:
# measured live at 1.191 s of Vapi endpointing before this process is invoked plus TTS
# after it emits, budgeted up to 1.25 s below. What is left -- 0.75 s -- is all the
# adapter has for the dead-air wait AND the control POST that delivers the line.
#VHV_ACK_BUDGET_SECONDS=2.0
#VHV_ACK_PLATFORM_OVERHEAD_SECONDS=1.25

# Seconds of dead air before an acknowledgement opportunity: the first one at turn
# start, and each later one a tool-start event re-arms. 0.3 s because it has to share
# the 0.75 s above with the control POST. Raising it does not buy silence: measured
# Hermes TTFB is 1.6-2.2 s warm, so no real answer was ever going to arrive first.
#VHV_FILLER_AFTER_SECONDS=0.3

# Cooldown between acknowledgements, GLOBAL TO THE CALL: once one is spoken, no
# other is spoken on this call until this many seconds have passed -- across turn
# boundaries, tool-start re-arms and cancelled/retried requests alike.
#VHV_FILLER_MIN_GAP_SECONDS=10.0

# Suffix fillers with Vapi's <flush /> token so they're spoken immediately.
# Requires voice.chunkPlan.enabled=true on the assistant (the Vapi default).
#VHV_FILLER_USE_FLUSH=true

# Comma-separated REASSURANCE lines (must be non-empty), spoken when a silence this
# call already acknowledged keeps running. A separate pool from VHV_FILLER_PHRASES on
# purpose, and the two may not overlap (the adapter refuses to start if they do):
# eleven seconds into a silence the callee said nothing eleven seconds ago, so a line
# that acknowledges them ("Got it, one second.") acknowledges nothing. These must read
# correctly as the SECOND thing said inside one silence.
#VHV_REASSURE_PHRASES=Still working on that.,Almost there, bear with me.

# Seconds of acknowledged silence before the FIRST reassurance. 0 (or negative)
# disables reassurance entirely. Measured need: on live call 01a028f1 an acknowledged
# turn was silent for 23.55 s while Hermes worked a multi-date calendar question, and
# across 34 journalled turns the acknowledgement-to-answer wait had p50 9.0 s, p75
# 14.6 s, max 33.2 s. Deliberately ABOVE VHV_FILLER_MIN_GAP_SECONDS: the cooldown
# stays the hard authority on spacing, and a timer sitting exactly on the floor makes
# every emission a boundary case for anyone measuring speaker-to-speaker.
#VHV_REASSURE_AFTER_SECONDS=11.0

# Multiplier on the wait before each FURTHER reassurance: gaps of 11 s, then 22 s,
# then 44 s, so the number of lines grows with the LOGARITHM of the wait. A 25 s wait
# hears one, a 60 s wait two. 1.0 gives a fixed cadence, which is the wrong shape: a
# holding phrase carries no information beyond "the line is still up", so its value
# decays with repetition while its cost does not.
#VHV_REASSURE_BACKOFF=2.0

# Speak acknowledgements through Vapi's Live Call Control endpoint
# (call.monitor.controlUrl, present on every request already, no assistant config
# change needed) instead of embedding them in the model.url SSE stream. Fixes a
# live, reproduced fault: a <flush />-terminated filler chunk left alone in the
# stream for more than a few seconds is not reliably spoken by Vapi's chunk-plan
# TTS pipeline (docs/integration-contracts.md section 1.6). Falls back to the
# SSE-embedded delivery automatically when no control URL is on the request or the
# control POST itself fails.
#VHV_ACK_USE_CALL_CONTROL=true

# Wall-clock ceiling on the control POST above. LEAVE UNSET: it is then derived, as
# VHV_ACK_BUDGET_SECONDS - VHV_ACK_PLATFORM_OVERHEAD_SECONDS - VHV_FILLER_AFTER_SECONDS
# = 2.0 - 1.25 - 0.3 = 0.45 s, so it cannot drift out of agreement with the other
# three. The POST is waited on only in order to give up on it and use the SSE fallback,
# so a ceiling bigger than the budget makes the fallback worthless: the old 3.0 s
# default put a live holding line 3.9 s after the callee stopped talking.
#VHV_ACK_CONTROL_TIMEOUT_SECONDS=0.45

# Ceiling on the control POST that speaks the ANSWER once an acknowledgement has gone
# out the same way. Deliberately not the tight value above: this runs on a background
# task with Hermes already finished, on no deadline, and cutting it short would
# truncate the actual answer.
#VHV_CONTROL_ANSWER_TIMEOUT_SECONDS=3.0

# --- outbound task calls -------------------------------------------------------
# The objective of an outbound call arrives as a Vapi dynamic variable, set when the
# call is created: assistantOverrides.variableValues.purpose (plus optional `callee`).
# Nothing here needs setting for that to work; see docs/integration-contracts.md 1.10.
# Fillers are always suppressed on the synthetic opening turn, regardless of the
# VHV_FILLER_* settings above.

# The principal's own number, E.164. When set, it is the authoritative way to tell
# "we called Mike" from "we called Mike's doctor" (customer.number is
# signalling-derived, unlike the free-text `callee` variable) and switches the opening
# to greeting the principal directly by name instead of "calling on behalf of Mike".
# Unset (the default) keeps third-party framing unless `callee` names the principal.
#VHV_PRINCIPAL_NUMBER=+15551234567

# Say "I'm an AI assistant calling for <principal>" in the opening when the callee is
# NOT the principal. On by default; turning it off must be deliberate. Never applies
# when the principal is the one who answered.
#VHV_OUTBOUND_DISCLOSE_AI=true

# Opening templates for an outbound call that carries a purpose. Both MUST contain
# {purpose} (validated at startup). {principal}, {assistant_name}, and {callee} are
# also substituted; any other {name} is left literal. Defaults are usually right.
#VHV_OUTBOUND_OPENING=You have just placed this call and whoever answered has not spoken yet. Open the call yourself: say that you are {assistant_name}, say you are calling on behalf of {principal}, and state the reason you are calling. The reason for this call is: {purpose} Do not greet {principal} and do not ask how you can help: {principal} is not on this call, and you are the one who needs something.
#VHV_OUTBOUND_OPENING_PRINCIPAL=You have just placed this call to {principal} and they have not spoken yet. Open the call by greeting {principal} directly by name, as yourself -- for example "Hi {principal}, {assistant_name} here." -- and then say why you are calling. The reason for this call is: {purpose} Do not say you are calling "for" or "on behalf of" {principal}, and do not refer to {principal} in the third person: {principal} is the person you are speaking to, not somebody who answers on their behalf.

# --- hermes routing (latency) --------------------------------------------------
# Routed model is ~5x faster to first token than the Hermes default route.
# Model and provider must be set together or both left unset -- a bare model is
# silently mis-routed, and the adapter refuses to start with only one of them.
# REASONING_EFFORT is unset by default (no opinion): "low" buys latency on the
# routed model but degrades multi-hop tool use.

#VHV_VOICE_MODEL=google/gemini-3.7-flash
#VHV_VOICE_PROVIDER=openrouter
#VHV_VOICE_REASONING_EFFORT=low

# Fire one tiny routed run at startup to absorb provider cold start (up to 24s).
#VHV_WARMUP_ON_START=true

# --- timeouts / limits ---------------------------------------------------------

#VHV_HERMES_CONNECT_TIMEOUT=5.0
#VHV_HERMES_FIRST_TOKEN_TIMEOUT=15.0
#VHV_HERMES_TURN_TIMEOUT=60.0
#VHV_HERMES_STOP_TIMEOUT=3.0

# Adapter concurrent-turn cap; keep below Hermes max_concurrent_runs (default 10).
#VHV_MAX_CONCURRENT_TURNS=5

#VHV_MAX_HISTORY_MESSAGES=200
#VHV_MAX_BODY_BYTES=1000000

# "none" = per-call random Hermes session ids; "hermes" = let Hermes persist sessions.
#VHV_SESSION_RETENTION=none

# Per-call state eviction (session ids + filler picker; loss mid-call is harmless).
#VHV_CALL_STATE_TTL_SECONDS=14400
#VHV_MAX_TRACKED_CALLS=1024

# The adapter's own record of the acknowledgements it emitted, served read-only at
# GET /debug/acks/{call_ref} behind the same Authorization bearer (and the same
# optional VHV_ROUTE_SECRET prefix) as /chat/completions.
#
# ON by default and safe to leave on. It holds nothing but phrases the ADAPTER chose
# from VHV_FILLER_PHRASES, the channel each went out on (control|stream) and two
# timestamps -- no caller speech, no transcript, no numbers, no secrets -- and its
# memory is capped three ways below (worst case 64 x 16 = 1024 records of <=200 chars,
# well under 1 MB; see docs/security.md).
#
# What it is FOR: an acknowledgement's text cannot say who wrote it. The model is
# forbidden from producing holding phrases, and several of the adapter's own defaults
# ("Okay, one moment.") are ordinary enough that a model-authored one is
# indistinguishable on the phone -- which silently defeats VHV_FILLER_MIN_GAP_SECONDS.
# This record is what lets tests/e2e tell the two apart. Set false to switch off
# recording AND unregister the route (it then 404s like any unknown path).
#VHV_DEBUG_ACK_JOURNAL=true
#VHV_DEBUG_ACK_JOURNAL_MAX_CALLS=64
#VHV_DEBUG_ACK_JOURNAL_MAX_ENTRIES_PER_CALL=16
#VHV_DEBUG_ACK_JOURNAL_TTL_SECONDS=900

# --- Vapi accepted our speech and never rendered it (silent-drop guard) ----------
# Vapi answers 200 to a Live Call Control `say`, pushes it onto its say queue, and
# then sometimes never speaks it -- no error, no event, the callee hears nothing (call
# 01a026d8: two of seven accepted pushes DROPPED). The adapter detects this from the
# conversation history Vapi already sends on the next turn -- NO assistant config
# change -- and re-delivers a dropped ANSWER once. Acknowledgements are recorded and
# never re-spoken: a stale "give me a second" is false, not merely redundant.
#
# How long after a delivery its absence from Vapi's record may mean it was dropped. A
# precondition on the verdict, NOT a trigger: nothing expires into "dropped", because
# a render can be 9.6s late and still arrive. Do not set below ~10s.
#VHV_SPEECH_CONFIRM_WINDOW_SECONDS=15.0
# Fraction of a delivery's content words that must appear in Vapi's record for it to
# count as spoken. Vapi RE-TRANSCRIBES rather than echoes, so this cannot be equality.
# Too low disarms the guard; too high re-speaks a spoken utterance.
#VHV_SPEECH_MATCH_THRESHOLD=0.5
# False keeps detection and journalling and only declines to act.
#VHV_SPEECH_DROP_REPLAY=true
#VHV_SPEECH_DROP_REPLAY_MAX_AGE_SECONDS=45.0
#VHV_SPEECH_DROP_MAX_REPLAYS_PER_CALL=2
# OPTIONAL faster feedback: set this to the assistant's `server.secret` to accept
# Vapi's speech-update webhooks at POST /vapi/server (Vapi sends the value as the
# x-vapi-secret header). UNSET means the route is NOT REGISTERED -- an assistant
# pointed here without this configured gets a 404 for every event, which is the
# fail-closed direction and costs nothing. Min 16 chars. Needs one additive field on
# the assistant: server:{url,secret}; `serverMessages` does NOT need editing.
#VHV_VAPI_SERVER_SECRET=

# Advisory tool policy (prompt-shaping only; real enforcement is the Hermes profile).
# Empty/unset ENABLED_TOOLS = no client-side opinion (defers entirely to the Hermes
# profile). Set it to the literal value "none" to explicitly tell the model to use
# no tools on this call.
#VHV_TOOL_POLICY__ENABLED_TOOLS=
#VHV_TOOL_POLICY__CONFIRM_TOOLS=
#VHV_TOOL_POLICY__MAX_TOOL_CALLS_PER_TURN=3
#VHV_TOOL_POLICY__MAX_TOOL_SECONDS_PER_CALL=60.0

# Transcript content is never logged.
